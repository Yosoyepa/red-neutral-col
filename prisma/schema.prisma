// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TestResult {
  id              String   @id @default(cuid())
  isp             String
  city            String
  downloadSpeed   Float
  uploadSpeed     Float
  ping            Int
  jitter          Float
  throttlingRatio Float?
  
  // Nuevos campos para pruebas de comparación de servicios
  videoStreamingSpeed Float? // Velocidad simulando streaming de video
  socialMediaSpeed   Float? // Velocidad simulando redes sociales
  generalWebSpeed    Float? // Velocidad para navegación general
  
  // Campos para compartir resultados
  shareId         String?  @unique
  isPublic        Boolean  @default(false)
  sharedAt        DateTime?
  
  testDate        DateTime @default(now())
  createdAt       DateTime @default(now())
}
