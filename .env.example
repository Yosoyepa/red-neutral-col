# Base de Datos
# Obtén tu string de conexión desde Supabase o tu proveedor de PostgreSQL
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# URL Base de la Aplicación
# En desarrollo usar http://localhost:3000
# En producción usar tu dominio (ej: https://red-neutral-col.vercel.app)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Google Gemini API Key (para el ChatBot)
# Obtén tu API key en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="tu_api_key_aqui"

# Opcional: Analytics (si usas Vercel Analytics)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your-analytics-id"
